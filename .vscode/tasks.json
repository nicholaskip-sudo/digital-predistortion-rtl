{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Run unit tests",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": []
        },
        {
